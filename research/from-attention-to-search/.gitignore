# Experiment workspace has moved out of this repository.
/experiments/

# Local experiment workspace under XingyuD. Track code, configs, and docs so
# collaborators can align on implementation. Keep raw data, checkpoints,
# figures, logs, and run outputs local.
XingyuD/Attention_Search_Experiments/**/data/
XingyuD/Attention_Search_Experiments/**/data_*/
XingyuD/Attention_Search_Experiments/**/checkpoints/
XingyuD/Attention_Search_Experiments/**/checkpoints_*/
XingyuD/Attention_Search_Experiments/**/figures/
XingyuD/Attention_Search_Experiments/**/figures_*/
XingyuD/Attention_Search_Experiments/**/logs/
XingyuD/Attention_Search_Experiments/**/logs_*/
XingyuD/Attention_Search_Experiments/**/outputs/
XingyuD/Attention_Search_Experiments/**/outputs_*/
XingyuD/Attention_Search_Experiments/**/results/
XingyuD/Attention_Search_Experiments/**/results_*/
XingyuD/Attention_Search_Experiments/**/runs/
XingyuD/Attention_Search_Experiments/**/runs_*/

# MoE routing worker surface: track source, configs, tests, manifests, and
# short run records; keep local environments, generated datasets, frozen
# source copies, checkpoints, and full run artifacts out of Git.
XingyuD/MoE_Routing_Experiments/**/.deps/
XingyuD/MoE_Routing_Experiments/**/.runtime_deps/
XingyuD/MoE_Routing_Experiments/**/.venv*/
XingyuD/MoE_Routing_Experiments/**/wheelhouse/
XingyuD/MoE_Routing_Experiments/**/data
XingyuD/MoE_Routing_Experiments/**/datasets
XingyuD/MoE_Routing_Experiments/**/logs/
XingyuD/MoE_Routing_Experiments/**/runs/
XingyuD/MoE_Routing_Experiments/**/contracts/preflight*/
XingyuD/MoE_Routing_Experiments/**/source_snapshots/

# Research-system experiment artifacts: keep curated summaries, small aggregate
# tables, protocols, scripts, and selected figures; do not track raw runs.
main/experiments/**/runs/
main/experiments/**/logs/
main/experiments/**/logs_*/
main/experiments/**/results/*/trained_runs/
main/experiments/**/results/*/checkpoint_artifacts/
main/experiments/**/results/*/**/checkpoint_artifacts/
main/experiments/**/results/*smoke*/
main/experiments/**/figures/*smoke*/

# Commit source, configs, Anchors, Protocols, Summaries, and Detailed records.
# Keep generated experiment tables, figures, logs, caches, and result notes local.
*.csv
*.tsv
*.png
*.jpg
*.jpeg
*.pdf
*.svg
*.html
*.jsonl
**/results/
**/runs/
**/logs/
**/checkpoints/
**/cache/
**/tables/**/*.json
**/figures/**/*.json
**/evidence/**/*.json

# Skip whole generated-result trees, including historical sync copies.
**/figures/
**/tables/
**/results/
**/evidence/

