    "source_function": "def learning_rate(step, train, total):\n    maximum, minimum = float(train.get('learning_rate', 3e-4)), float(train.get('min_learning_rate', 3e-5))\n    warm = int(train.get('warmup_updates', 256))\n    if warm and step < warm:\n        return maximum*(step+1)/warm\n    fraction = (step-warm)/max(total-warm-1, 1)\n    return minimum+(maximum-minimum)*.5*(1+math.cos(math.pi*min(max(fraction, 0.), 1.)))",
