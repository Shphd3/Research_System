# OS / cloud sync
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.temp
*.bak
*.icloud
~$*

# Archives and generated packages
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# Large binary research artifacts
*.pdf
*.pages

# Curated paper artifacts for the uniform-feature MoE paper.
!papers/uniform_feature_moe_initialization/latex/*.pdf
!papers/uniform_feature_moe_initialization/latex/figures/*.pdf

# LaTeX build outputs
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc

# Python / caches
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.side/
.research/runtime/

# Local environments
.venv/
venv/
env/

# Project workspaces are independent repositories. Keep only the shared graph
# hub and explicitly curated course-delivery projects visible to this root
# research-system repo.
Projects/*
!Projects/graphs/
!Projects/graphs/**
!Projects/academic_writing/
!Projects/academic_writing/**

# Academic Writing course project: keep source notes and reusable resources in
# Git; keep generated builds, final submission archives, and local drafts out
# unless explicitly force-added for a submission record.
Projects/academic_writing/**/build/
Projects/academic_writing/**/compiled/
Projects/academic_writing/**/exports/
Projects/academic_writing/**/*.zip
Projects/academic_writing/**/*.pdf
Projects/academic_writing/**/~$*

# Daily research: retain canonical Markdown and scripts, keep generated payloads local.
/daily_research_reports/**/*.csv
/daily_research_reports/**/*.png
/daily_research_reports/**/*.svg
/daily_research_reports/**/*.pdf
/daily_research_reports/**/*.jsonl
/daily_research_reports/**/*.npz
/daily_research_reports/**/*.npy
/daily_research_reports/**/*.html
/daily_research_reports/**/tables/**/*.json
/daily_research_reports/**/figures/**/*.json
/daily_research_reports/**/results/**/*.json
/daily_research_reports/**/report_assets/fonts/

# Skip walking local generated-result trees during Git status/commit.
/daily_research_reports/**/figures/
/daily_research_reports/**/tables/
/daily_research_reports/**/results/

# Local registration locks and generated analysis completion trees.
/assets/.*.lock
/daily_research_reports/**/results_completed/
